#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Prefer Homebrew Ruby to the older macOS system Ruby.
for ruby_bin in /opt/homebrew/opt/ruby/bin /usr/local/opt/ruby/bin; do
  if [[ -x "$ruby_bin/ruby" ]]; then
    export PATH="$ruby_bin:$PATH"
    break
  fi
done
export BUNDLE_GEMFILE="$PWD/Gemfile.preview"
export BUNDLE_PATH="$PWD/vendor/preview"
export BUNDLE_APP_CONFIG="$PWD/.bundle/preview"
bundle check || bundle install --jobs 4
exec bundle exec jekyll serve --host 127.0.0.1 --port 4000 "$@"
